# ===================== MinerU PDF解析配置 =====================
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=/path/to/modelscope_cache
HF_HOME=/path/to/huggingface_cache
MD_ROOT_DIR=./temp-files/

# MinerU API配置
# api_key申请地址：https://mineru.net
MINERU_API_TOKEN=your_mineru_api_token_here
MINERU_BASE_URL=https://mineru.net/api/v4

# ===================== LLM 大模型配置（百炼 DashScope） =====================
# api_key申请地址：https://bailian.console.aliyun.com/cn-beijing/#/api-key
# 文档地址：https://bailian.console.aliyun.com/cn-beijing/#/doc
OPENAI_API_KEY=sk-your_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Qwen3系列Flash模型，支持思考/非思考模式切换，1M上下文
LLM_DEFAULT_MODEL=qwen-flash
# Qwen3系列视觉理解模型，支持图像/视频理解
VL_MODEL=qwen3-vl-flash
LLM_DEFAULT_TEMPERATURE=0.1

# ===================== MCP 联网搜索配置 =====================
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse

# ===================== Embedding 模型配置 (BGE-M3) =====================
BGE_M3_PATH=/path/to/models/BAAI/bge-m3
BGE_M3=BAAI/bge-m3
# GPU模式（推荐）
BGE_DEVICE=cuda:0
BGE_FP16=1
# CPU模式（备选，需关闭FP16）
# BGE_DEVICE=cpu
# BGE_FP16=0

# 物品名称诊断开关
ITEM_NAME_DIAG=1

# ===================== Milvus 向量数据库配置 =====================
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=kb_chunks
ENTITY_NAME_COLLECTION=kb_graph_entity_names
ITEM_NAME_COLLECTION=kb_item_names

EMBEDDING_DIM=1536
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75

# ===================== Neo4j 图数据库配置 =====================
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ===================== MongoDB 配置 =====================
MONGO_URL=mongodb://admin:your_password@localhost:27017
MONGO_DB_NAME=kb002

# ===================== MinIO 对象存储配置 =====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=/upload-images
MINIO_SECURE=False

# ===================== 重排序模型配置 (BGE-Reranker) =====================
BGE_RERANKER_LARGE=/path/to/models/BAAI/bge-reranker-large
# GPU模式
# BGE_RERANKER_DEVICE=cuda:0
# BGE_RERANKER_FP16=1
# CPU模式（默认）
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0

# ===================== 日志配置 =====================
# 控制台日志：True=开启 / False=关闭
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO

# 文件日志：True=开启 / False=关闭
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
# 日志文件保留天数
LOG_FILE_RETENTION=7 days